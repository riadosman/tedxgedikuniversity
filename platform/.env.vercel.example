# Add to Vercel Production. Use a SEPARATE database and keys for Preview.
DJANGO_ENV=production
DJANGO_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
CREDENTIAL_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_SSLMODE=require
PUBLIC_BASE_URL=https://YOUR-PROJECT.vercel.app
ALLOWED_HOSTS=YOUR-PROJECT.vercel.app
CSRF_TRUSTED_ORIGINS=https://YOUR-PROJECT.vercel.app
MFA_REQUIRED=true
DEV_ONE_CLICK_LOGIN=false
DEV_EVENT_REHEARSAL=false
TRUST_PROXY_HTTPS=true
OUTGOING_EMAIL_ENABLED=false
EXPECT_BACKGROUND_JOBS=false
MIN_FREE_STORAGE_BYTES=0
LOG_LEVEL=INFO
