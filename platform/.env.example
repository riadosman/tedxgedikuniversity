# Copy to ../.env. Never commit the completed file.
DJANGO_ENV=development
# Explicit localhost-only shortcut; never enable on a deployed instance.
DEV_ONE_CLICK_LOGIN=false
DEV_LOGIN_EVENT=tedxgedik
# Rehearsal of the configured event before doors open, localhost only.
DEV_EVENT_REHEARSAL=false
DJANGO_SECRET_KEY=replace-with-generated-random-value
DATABASE_URL=postgresql://tedx:replace-password@127.0.0.1:55432/tedx
CREDENTIAL_KEY=replace-with-Fernet-generated-key
BACKUP_KEY=replace-with-a-different-Fernet-generated-key
DB_SSLMODE=prefer
PRIVATE_MEDIA_ROOT=../.local/media
ALLOWED_HOSTS=127.0.0.1,localhost
PUBLIC_BASE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=../.local/mail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
MFA_REQUIRED=true
FILE_SCAN_COMMAND=
PAYMENT_PROVIDER=
LOG_LEVEL=INFO
TRUST_PROXY_HTTPS=false

# Monitoring and reviewed HSTS scope
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
EXPECT_BACKGROUND_JOBS=false
MIN_FREE_STORAGE_BYTES=1073741824
BACKUP_DIRECTORY=
BACKUP_MAX_AGE_SECONDS=90000

# Set false to operate registration without any mail provider.
# This also pauses other outbound communications; staff authentication is unchanged.
OUTGOING_EMAIL_ENABLED=true
